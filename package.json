{
  "name": "mtigo",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc --noEmit -p . && vite build",
    "test:unit": "vitest run",
    "test:db": "node --test --test-reporter=spec tests/db/*.test.mjs",
    "test": "npm run test:unit && npm run test:db",
    "images": "node scripts/make-images.mjs",
    "android:sync": "npm run build && cap sync android",
    "test:e2e": "node tests/e2e/flow.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/leaflet": "^1.9.22",
    "embedded-postgres": "^18.7.0-beta.19",
    "jsdom": "^31.0.1",
    "pg": "^8.23.1",
    "puppeteer-core": "^25.18.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/poppins": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "leaflet": "^1.9.4"
  }
}
