# Copia este archivo como .env y completa con los datos de TU proyecto Supabase
# (Supabase > Project Settings > API). La anon key es pública; NUNCA uses la service_role key aquí.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# URL pública de la versión web (GitHub Pages). Se usa en correos de confirmación y recuperación.
VITE_PUBLIC_WEB_URL=https://artjmarcos.github.io/mtigo/
# Correo de contacto/soporte visible en la app y en Google Play.
VITE_SUPPORT_EMAIL=
